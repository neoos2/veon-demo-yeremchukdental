---
// Small inline icons: phone, messengers, socials, arrow, chevron, menu. Decorative (labels are always in text).
type Name = "phone" | "viber" | "telegram" | "whatsapp" | "instagram" | "facebook" | "youtube" | "arrow" | "chevron" | "menu" | "close" | "pin";
interface Props { name: Name; class?: string; size?: number }
const { name, class: cls, size = 20 } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "viber" && <Fragment><path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v5a4.5 4.5 0 0 1-4.5 4.5H12l-4.5 4v-4A4.5 4.5 0 0 1 3 12.5v-5A4.5 4.5 0 0 1 7.5 3Z" /><path d="M8.2 7.2c.3-.2.6-.2.8.1l.7 1c.2.3.1.6-.2.8l-.3.3c.4.8 1 1.4 1.8 1.8l.3-.3c.2-.3.5-.4.8-.2l1 .7c.3.2.3.5.1.8-.4.6-1 .8-1.7.6a5.4 5.4 0 0 1-3.8-3.8c-.2-.7 0-1.3.5-1.8Z" /><path d="M13.5 5.8a3.6 3.6 0 0 1 3 3M13.3 7.7a1.7 1.7 0 0 1 1.3 1.3" /></Fragment>}
  {name === "telegram" && <path d="m21 4.5-18 7 6 2 2 6 3.2-3.8L19 19.5Zm-12 9 9-6.5" />}
  {name === "whatsapp" && <Fragment><path d="M4.2 20 5.4 16A8.5 8.5 0 1 1 8.4 19Z" /><path d="M9.3 8.2c.3-.3.7-.3.9 0l.7 1.2c.2.3.1.6-.1.8l-.4.4c.4.9 1.1 1.6 2 2l.4-.4c.2-.2.5-.3.8-.1l1.2.7c.3.2.3.6 0 .9-.6.6-1.4.8-2.2.5a6 6 0 0 1-3.8-3.8c-.2-.8 0-1.6.5-2.2Z" /></Fragment>}
  {name === "instagram" && <Fragment><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></Fragment>}
  {name === "facebook" && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4A21 21 0 0 0 15.3 4.3c-2.3 0-3.8 1.4-3.8 4v2.2H9v3h2.5V21" />}
  {name === "youtube" && <Fragment><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10 9 5 3-5 3Z" fill="currentColor" /></Fragment>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "pin" && <Fragment><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></Fragment>}
</svg>
