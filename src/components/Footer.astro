---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { FUTURE, phone, messengers, socials, branches } from "../data/clinic";
const anchors = [
  { href: "#directions", label: "Послуги і ціни" },
  { href: "#doctors", label: "Лікарі" },
  { href: "#offers", label: "Акції" },
  { href: "#abroad", label: "З-за кордону" },
  { href: "#branches", label: "Філії" },
];
const social = [
  { ...socials.instagramIf, icon: "instagram" as const },
  { ...socials.instagramCv, icon: "instagram" as const },
  { ...socials.facebook, icon: "facebook" as const },
  { ...socials.youtube, icon: "youtube" as const },
];
---
<footer class="site-footer on-field" data-rec="UX-R011,SM-R004">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href="#top">
        <Image src={logo} alt="Yeremchuk Dental, на початок сторінки" width={168} height={80} densities={[1, 2]} loading="lazy" />
      </a>
      <p class="footer__addr">
        {branches.map((b) => <span>{b.city}, {b.address}</span>)}
      </p>
    </div>
    <nav class="footer__col footer__col--nav" aria-label="Розділи сторінки">
      <ul>
        {anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
        <li><FutureLink note={FUTURE}>Політика конфіденційності</FutureLink></li>
      </ul>
    </nav>
    <div class="footer__col footer__col--contact">
      <a class="footer__tel num" href={phone.href}>{phone.label}</a>
      <ul>
        {messengers.map((m) => <li><a href={m.href} rel="noopener"><Icon name={m.id} />{m.label}</a></li>)}
      </ul>
    </div>
    <div class="footer__col footer__col--social">
      <ul>
        {social.map((s) => <li><a href={s.href} rel="noopener"><Icon name={s.icon} />{s.icon === "instagram" && <span class="visually-hidden">Instagram </span>}{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer__base">
    <p>© 2019–2026 Yeremchuk Dental</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--s-8) var(--s-6); }
  .footer__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-6) var(--gap); }
  .footer__brand { grid-column: 1 / span 4; display: grid; gap: var(--s-5); align-content: start; justify-items: start; }
  .footer__logo { display: inline-block; padding: var(--s-3) var(--s-4); background: var(--color-bg); border-radius: var(--radius); }
  .footer__logo :global(img) { width: 168px; height: auto; }
  .footer__addr { display: grid; gap: var(--s-1); color: var(--color-on-field-muted); }
  .footer__col { display: grid; gap: var(--s-3); align-content: start; }
  .footer__col--nav { grid-column: 5 / span 2; }
  .footer__col--contact { grid-column: 7 / span 3; }
  .footer__col--social { grid-column: 10 / span 3; }
  .footer__col ul { list-style: none; display: grid; }
  .footer__col a, .footer__col :global(.future-link) {
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--tap);
    text-decoration: none; color: var(--color-on-field); transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .footer__col :global(.future-link) { color: var(--color-on-field-muted); text-decoration: underline dotted; text-underline-offset: 0.3em; }
  .footer__col a:hover { color: var(--color-accent); }
  .footer__col :global(svg) { color: var(--color-accent); }
  .footer__tel { font: 600 var(--fs-body)/1.2 var(--font-display); white-space: nowrap; }
  .footer__base { margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--color-field-rule); font-size: var(--fs-xs); color: var(--color-on-field-muted); }
  @media (max-width: 1023px) {
    .footer__brand { grid-column: 1 / -1; }
    .footer__col--nav, .footer__col--contact, .footer__col--social { grid-column: span 4; }
  }
  @media (max-width: 599px) {
    .footer__col--nav, .footer__col--contact, .footer__col--social { grid-column: 1 / -1; }
  }
</style>
