---
import FutureLink from "./FutureLink.astro";
import CallButton from "./CallButton.astro";
import { FUTURE, restore, groups, consultations } from "../data/clinic";
---
<section id="directions" class="section directions" data-rec="UX-R006,GA-R007,MA-R003" aria-labelledby="directions-title">
  <div class="container">
    <div class="section-head">
      <h2 id="directions-title">Імплантація від 21&nbsp;600 грн і ще десять напрямів</h2>
      <p>Ціну «від» показуємо там, де вона є в прайсі клініки.</p>
    </div>

    <div class="dir-grid">
      <article class="dir-main" data-reveal>
        <h3 class="dir-main__title">Відновити зуби</h3>
        <FutureLink note={FUTURE} class="lead-row">
          <span class="lead-row__name">Імплантація</span>
          <span class="lead-row__price num">від 21 600 грн</span>
          <span class="lead-row__detail">All-on-4, All-on-6, одномоментна, одноетапна (експрес), базальна, лазерна, під ключ, при повній відсутності зубів</span>
        </FutureLink>
        <ul class="rows">
          {restore.map((r) => (
            <li>
              <FutureLink note={FUTURE} class="row">
                <span class="row__name">{r.name}</span>
                {r.price && <span class="row__price">{r.price}</span>}
                {r.detail && <span class="row__detail">{r.detail}</span>}
              </FutureLink>
            </li>
          ))}
        </ul>
      </article>

      <div class="dir-side">
        {groups.map((g, i) => (
          <article class="dir-group" data-reveal style={`--reveal-delay:${(i + 1) * 40}ms`}>
            <h3 class="dir-group__title">{g.title}</h3>
            <ul class="rows">
              {g.rows.map((r) => (
                <li>
                  <FutureLink note={FUTURE} class="row">
                    <span class="row__name">{r.name}</span>
                    {r.price && <span class="row__price">{r.price}</span>}
                    {r.detail && <span class="row__detail">{r.detail}</span>}
                  </FutureLink>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <div class="consult">
      <div class="consult__text">
        <h3>Почати з консультації</h3>
        <ul class="consult__list">
          {consultations.map((c) => (
            <li><span>{c.name}</span> <span class="consult__price num">{c.price}</span></li>
          ))}
        </ul>
      </div>
      <CallButton />
    </div>
    <p class="note">Ціни з прайсу клініки, перевірено в листопаді 2026 року.</p>
  </div>
</section>

<style>
  .dir-grid {
    display: grid; gap: var(--s-6) var(--gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }
  .dir-main { grid-column: 1 / span 5; }
  .dir-side { grid-column: 7 / span 6; display: grid; gap: var(--s-6); }
  .dir-main__title, .dir-group__title {
    font: 400 var(--fs-body)/1.3 var(--font-body); color: var(--color-muted);
    padding-bottom: var(--s-3); border-bottom: 1px solid var(--color-text);
  }

  :global(.lead-row) {
    display: grid; gap: var(--s-2); padding: var(--s-5) 0 var(--s-6);
    text-decoration: none; border-bottom: 1px solid var(--color-rule);
  }
  .lead-row__name { font: 300 var(--fs-h2)/1.1 var(--font-display); letter-spacing: -0.015em; }
  .lead-row__price { font: 600 clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem)/1 var(--font-display); color: var(--color-link); letter-spacing: -0.02em; }
  .lead-row__detail { color: var(--color-muted); max-width: 30rem; }

  .rows { list-style: none; }
  .rows li { border-bottom: 1px solid var(--color-rule); }
  :global(.row) {
    display: grid !important; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--s-4); row-gap: var(--s-1);
    padding: var(--s-4) 0; text-decoration: none; width: 100%;
  }
  .row__name { font-size: var(--fs-lead); position: relative; justify-self: start; }
  .row__price { font: 600 var(--fs-body)/1.4 var(--font-display); color: var(--color-link); text-align: right; font-variant-numeric: tabular-nums; min-width: 0; }
  .row__detail { grid-column: 1 / -1; font-size: var(--fs-xs); color: var(--color-muted); }
  .row__name::after, .lead-row__name::after { content: none; }
  :global(.row):hover .row__name, :global(.lead-row):hover .lead-row__name { color: var(--color-link); }
  :global(.row), :global(.lead-row) { transition: background-color var(--dur-fast) var(--ease-out); }
  .row__name, .lead-row__name { transition: color var(--dur-fast) var(--ease-out); }

  .consult {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem); padding: var(--s-6) 0;
    border-top: 1px solid var(--color-text); border-bottom: 1px solid var(--color-text);
    display: flex; flex-wrap: wrap; gap: var(--s-5); align-items: center; justify-content: space-between;
  }
  .consult__text { display: grid; gap: var(--s-4); }
  .consult h3 { font: 300 var(--fs-h3)/1.2 var(--font-display); }
  .consult__list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); }
  .consult__list li { display: flex; gap: var(--s-2); align-items: baseline; flex-wrap: wrap; }
  .consult__price { font: 600 var(--fs-lead)/1.2 var(--font-display); color: var(--color-link); }
  .note { margin-top: var(--s-4); font-size: var(--fs-xs); color: var(--color-muted); }

  @media (min-width: 1024px) {
    .dir-main { position: sticky; top: calc(var(--header-h) + var(--s-6)); align-self: start; }
  }
  @media (max-width: 1023px) {
    .dir-main, .dir-side { grid-column: 1 / -1; }
  }
  @media (max-width: 479px) {
    :global(.row) { grid-template-columns: minmax(0, 1fr); }
    .row__price { text-align: left; grid-row: 2; }
  }
  @media (max-width: 599px) {
    .consult :global(.btn) { width: 100%; }
    .consult__list { display: grid; }
  }
</style>
